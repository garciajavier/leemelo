{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/logo.svg", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/fonts/**", "/classics/covers/**"]
      }
    },
    {
      "name": "classics",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/classics/*.epub"]
      }
    }
  ]
}
